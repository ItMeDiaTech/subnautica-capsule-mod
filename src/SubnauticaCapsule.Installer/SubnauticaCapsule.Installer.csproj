<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SubnauticaCapsule.Installer</RootNamespace>
    <AssemblyName>SubnauticaCapsule.Installer</AssemblyName>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <ModDllPath>..\SubnauticaCapsule.Mod\bin\$(Configuration)\net472\SubnauticaCapsule.dll</ModDllPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ModDllPath)')">
    <EmbeddedResource Include="$(ModDllPath)" LogicalName="SubnauticaCapsule.dll" />
  </ItemGroup>

</Project>
